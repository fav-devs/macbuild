#!/bin/bash
# Builds an Expo app on this Mac (eas build --local), answering the EAS prompts.
#   macbuild <project> [--platform ios|android] [--profile NAME] [--ref REF] [--install] [--submit] [--skip-unchanged]
#   --platform ios|android  default ios; --android is short for --platform android
#   --profile NAME     eas.json build profile (default development, or production with --submit)
#   --ref REF          build a pushed branch, tag or commit in a clean checkout (default: the working copy)
#   --install          install on the iPhone in MACBUILD_DEVICE, the simulator, or the Android device on adb
#   --screenshot PATH  with --install on a simulator, save a screenshot of the app once it's open
#   --submit           upload to TestFlight or Google Play afterwards (eas submit); --testflight works too
#   --skip-unchanged   reuse the last build of this profile when the native code hasn't changed
#   --fast             fixed work directory + Xcode compilation caching, so later builds reuse compiled output
#   --send             Taildrop the build to MACBUILD_TAILDROP_TARGET
#   --output PATH      where the build goes (default: your Desktop)
# Other commands: macbuild list | add <name> <path> | scan | doctor | setup | builds | log | show | commit <name> [--push]
# Projects: ~/.config/macbuild/projects.conf (name|path). Settings: ~/.config/macbuild/env.
# Build history (for agents): ~/.local/share/macbuild/builds/<id>/{meta.json,build.log}
set -u
START=$SECONDS
HERE=$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd); [ -d "$HERE/../lib" ] || HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
# LaunchAgents for the dashboard and menu bar (UI_PLIST, BAR_PLIST, set_login).
. "$ROOT/lib/agents.sh"
CONFIG="$HOME/.config/macbuild"; PROJECTS="${MACBUILD_PROJECTS:-$CONFIG/projects.conf}"
[ -f "$CONFIG/env" ] && . "$CONFIG/env"
export MACBUILD_APPLE_ID MACBUILD_APPLE_PASSWORD_FILE
# Builds that ran, by native fingerprint: name|profile|platform|fingerprint|artifact|time. Read by --skip-unchanged.
FINGERPRINTS="$HOME/.local/share/macbuild/fingerprints"
# Project names end up in URLs, file names and build ids.
valid_name() { case "$1" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1;; esac; }
has_name() { N="$1" awk -F'|' '$1==ENVIRON["N"]{f=1} END{exit !f}' "$PROJECTS" 2>/dev/null; }
has_dir() { D="$1" awk -F'|' '$2==ENVIRON["D"]{f=1} END{exit !f}' "$PROJECTS" 2>/dev/null; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'; }
android_env() {
  # Android Studio's usual SDK and Java, unless the env file says otherwise. Exported, since eas and Gradle read them.
  if [ -z "${ANDROID_HOME:-}" ] && [ -d "$HOME/Library/Android/sdk" ]; then ANDROID_HOME="$HOME/Library/Android/sdk"; fi
  if [ -n "${ANDROID_HOME:-}" ]; then export ANDROID_HOME ANDROID_SDK_ROOT="$ANDROID_HOME"; PATH="$ANDROID_HOME/platform-tools:$PATH"; fi
  if [ -z "${JAVA_HOME:-}" ]; then
    JAVA_HOME=$(/usr/libexec/java_home -v 17 2>/dev/null) || JAVA_HOME=""
    if [ -z "$JAVA_HOME" ] && [ -d "/Applications/Android Studio.app/Contents/jbr/Contents/Home" ]; then JAVA_HOME="/Applications/Android Studio.app/Contents/jbr/Contents/Home"; fi
  fi
  if [ -n "${JAVA_HOME:-}" ]; then export JAVA_HOME; fi
}
add_project() {
  local name="$1" dir
  valid_name "$name" || { echo "bad name: $name (letters, digits, '.', '_' and '-', starting with a letter or digit)"; return 1; }
  dir=$(cd "$2" 2>/dev/null && pwd) || { echo "no such folder: $2"; return 1; }
  [ -f "$dir/eas.json" ] || { echo "no eas.json in $dir"; return 1; }
  mkdir -p "$CONFIG"; touch "$PROJECTS"
  N="$name" awk -F'|' '$1!=ENVIRON["N"]' "$PROJECTS" > "$PROJECTS.tmp"
  echo "$name|$dir" >> "$PROJECTS.tmp"; mv "$PROJECTS.tmp" "$PROJECTS"; echo "added $name: $dir"
}
scan_projects() {
  # Expo apps under the usual project folders; an app already listed keeps its name. When two apps share a folder name
  # (apps/mobile in two monorepos), the second is named after its repository too, so neither replaces the other.
  local root file dir name repo n
  for root in "$HOME/Documents" "$HOME/Developer" "$HOME/Projects" "$HOME/code" "$HOME/src"; do
    [ -d "$root" ] || continue
    find "$root" -maxdepth 4 -name eas.json -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | while read -r file; do
      dir=$(dirname "$file")
      has_dir "$dir" && continue
      name=$(slug "$(basename "$dir")"); name=${name:-app}
      if has_name "$name"; then
        repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && repo=$(slug "$(basename "$repo")")
        if [ -n "$repo" ] && [ "$repo" != "$name" ] && ! has_name "$repo-$name"; then name="$repo-$name"
        else n=2; while has_name "$name-$n"; do n=$((n + 1)); done; name="$name-$n"; fi
      fi
      add_project "$name" "$dir"
    done
  done
}
doctor() {
  local bad=0 names json=0 items
  [ "${1:-}" = --json ] && json=1
  items=$(mktemp "${TMPDIR:-/tmp}/macbuild-doctor.XXXXXX") || return 1
  rec() {
    python3 -c 'import json,sys; json.dump({"id":sys.argv[1],"label":sys.argv[2],"status":sys.argv[3],"detail":sys.argv[4]},sys.stdout); print()' "$1" "$2" "$3" "$4" >> "$items"
  }
  sid() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr ' ' '-'; }
  ok() { rec "$(sid "$1")" "$1" ok "$2"; [ "$json" = 1 ] || printf '  ok    %-12s %s\n' "$1" "$2"; }
  no() { rec "$(sid "$1")" "$1" miss "$2"; bad=1; [ "$json" = 1 ] || printf '  MISS  %-12s %s\n' "$1" "$2"; }
  opt() { rec "$(sid "$1")" "$1" skip "$2"; [ "$json" = 1 ] || printf '  skip  %-12s %s\n' "$1" "$2"; }
  [ "$(uname)" = Darwin ] && ok macOS "$(sw_vers -productVersion)" || no macOS "iOS builds need a Mac"
  xcodebuild -version >/dev/null 2>&1 && ok Xcode "$(xcodebuild -version | head -1)" || no Xcode "install from the App Store, then run: sudo xcode-select -s /Applications/Xcode.app"
  command -v node >/dev/null && ok node "$(node -v)" || no node "install Node.js 20 or newer"
  command -v git >/dev/null && ok git "$(git --version | cut -d' ' -f3)" || no git "xcode-select --install"
  command -v pod >/dev/null && ok CocoaPods "$(pod --version 2>/dev/null)" || no CocoaPods "brew install cocoapods"
  command -v fastlane >/dev/null && ok fastlane "installed" || no fastlane "brew install fastlane"
  if command -v eas >/dev/null; then
    ok eas-cli "$(eas --version 2>/dev/null | grep -o 'eas-cli/[0-9.]*' | head -1)"
    who=$(eas whoami 2>/dev/null | grep -vE 'eas-cli@|upgrade|npm install|outdated' | grep -m1 .); case "$who" in ""|*"Not logged in"*) no "Expo login" "run: eas login";; *) ok "Expo login" "$who";; esac
  else no eas-cli "npm install -g eas-cli"; fi
  command -v gh >/dev/null && gh auth status >/dev/null 2>&1 && ok "GitHub CLI" "signed in" || opt "GitHub CLI" "optional: PR and CI details in the web UI"
  if [ -x "$HOME/.t3/bin/t3" ] || command -v t3 >/dev/null; then ok "T3 CLI" "split and push local git changes"
  else opt "T3 CLI" "optional: dashboard can split, commit and push local git changes"; fi
  [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] || command -v tailscale >/dev/null && ok Tailscale "installed" || opt Tailscale "optional: needed to use the web UI from a phone"
  android_env
  [ -n "${ANDROID_HOME:-}" ] && [ -d "$ANDROID_HOME" ] && ok "Android SDK" "$ANDROID_HOME" || opt "Android SDK" "for Android builds: install Android Studio"
  [ -n "${JAVA_HOME:-}" ] && ok "Java 17" "$JAVA_HOME" || opt "Java 17" "for Android builds: brew install --cask zulu@17"
  [ -s "$PROJECTS" ] && ok projects "$(grep -c '|' "$PROJECTS") listed" || no projects "run: macbuild scan, or macbuild add <name> <path>"
  names=$(grep -v '^#' "$PROJECTS" 2>/dev/null | grep '|' | cut -d'|' -f1 | while read -r name; do valid_name "$name" || printf '"%s" ' "$name"; done)
  [ -z "$names" ] || no names "rename ${names}in $PROJECTS: letters, digits, '.', '_' and '-' only"
  if [ "$json" = 1 ]; then
    python3 -c '
import json, sys
items = [json.loads(line) for line in open(sys.argv[1]) if line.strip()]
json.dump({"ok": all(item["status"] != "miss" for item in items), "items": items}, sys.stdout)
print()
' "$items"
  fi
  rm -f "$items"
  return $bad
}
dashboard_url() {
  if [ -n "${MACBUILD_UI_URL:-}" ]; then printf '%s\n' "$MACBUILD_UI_URL"; return; fi
  python3 -c '
import os, re, sys
plist = os.path.join(os.environ["HOME"], "Library/LaunchAgents/local.macbuild.ui.plist")
try: text = open(plist).read()
except OSError: sys.exit(0)
m = re.search(r"<key>MACBUILD_UI_URL</key>\s*<string>([^<]*)</string>", text)
print(m.group(1) if m and m.group(1) else "http://127.0.0.1:4180")
'
}
setup_cmd() {
  local do_ui=0 do_login="" do_bar="" do_open=0
  for arg in "$@"; do
    case "$arg" in
      --ui) do_ui=1;;
      --login) do_login=1;;
      --nologin|--no-login) do_login=0;;
      --menubar) do_bar=1;;
      --no-menubar) do_bar=0;;
      --open) do_open=1;;
      --json) doctor --json; return $?;;
      -h|--help) printf '%s\n' "macbuild setup [--ui] [--login|--nologin] [--menubar|--no-menubar] [--open]"; return 0;;
      *) echo "unknown option $arg"; return 2;;
    esac
  done
  if [ "$do_ui" = 1 ]; then
    [ -f "$ROOT/install-ui.sh" ] || { echo "install-ui.sh missing"; return 1; }
    "$ROOT/install-ui.sh" || return 1
  fi
  if [ -n "$do_login" ]; then
    if [ ! -f "$UI_PLIST" ]; then echo "install the dashboard first: macbuild setup --ui"; return 1; fi
    set_login "$do_login"
    echo "login $( [ "$do_login" = 1 ] && echo on || echo off )"
  fi
  if [ "$do_bar" = 1 ]; then
    [ "$(uname)" = Darwin ] || { echo "menu bar needs macOS"; return 1; }
    [ -f "$ROOT/install-ui.sh" ] || { echo "install-ui.sh missing"; return 1; }
    "$ROOT/install-ui.sh" --menubar-only || return 1
    echo "menu bar on"
  fi
  if [ "$do_bar" = 0 ]; then
    save_login_pref "$(saved_login)" false
    [ -f "$BAR_PLIST" ] && set_plist_login "$BAR_PLIST" false || true
    bootout_agent "$BAR_LABEL"
    echo "menu bar off"
  fi
  if [ "$do_open" = 1 ]; then
    url=$(dashboard_url)
    [ -n "$url" ] || url="http://127.0.0.1:4180"
    open "$url/#/setup" 2>/dev/null || echo "$url/#/setup"
    return 0
  fi
  url=$(dashboard_url)
  printf 'macbuild setup\n\n'
  printf '  dashboard  %s\n' "${url:-off  (macbuild setup --ui)}"
  printf '  login      %s\n' "$( [ -f "$UI_PLIST" ] && plist_login "$UI_PLIST" && echo on || echo off )"
  printf '  menu bar   %s\n' "$( agent_loaded "$BAR_LABEL" && echo on || { [ -x "$BAR_BIN" ] && echo installed; } || echo off )"
  echo
  doctor
  echo
  echo "Guide: ${url:-http://127.0.0.1:4180}/#/setup"
}
# History the web UI writes: meta.json + build.log per job. Agents read this instead of scraping the dashboard.
history() {
  local mode="$1" query="" json=0 arg
  shift
  for arg in "$@"; do
    [ -n "$arg" ] || continue
    case "$arg" in --json) json=1;; *) query="$arg";; esac
  done
  MACBUILD_DATA="${MACBUILD_DATA:-$HOME/.local/share/macbuild/builds}" python3 - "$mode" "$query" "$json" <<'PY'
import json, os, sys
mode, query, as_json = sys.argv[1], sys.argv[2], sys.argv[3] == "1"
data = os.environ["MACBUILD_DATA"]

def metas():
    items = []
    if not os.path.isdir(data):
        return items
    for name in os.listdir(data):
        path = os.path.join(data, name, "meta.json")
        if not os.path.isfile(path):
            continue
        try:
            meta = json.load(open(path))
        except (OSError, json.JSONDecodeError):
            continue
        meta["_dir"] = os.path.join(data, name)
        items.append(meta)
    items.sort(key=lambda item: item.get("createdAt") or 0, reverse=True)
    return items

def pick(items):
    if not query:
        return items[0] if items else None
    for item in items:
        ident = item.get("id") or ""
        if ident == query or ident.startswith(query):
            return item
    for item in items:
        if item.get("project") == query:
            return item
    return None

def public(item):
    return {key: value for key, value in item.items() if not key.startswith("_")}

items = metas()
if mode == "builds":
    if query:
        items = [item for item in items if item.get("project") == query or (item.get("id") or "").startswith(query)]
    if as_json:
        json.dump([public(item) for item in items], sys.stdout, indent=2)
        sys.stdout.write("\n")
        sys.exit(0)
    if not items:
        print("no builds yet")
        sys.exit(0)
    for item in items[:50]:
        reason = (item.get("reason") or "").replace("\n", " ")
        print("{id}\t{status}\t{project}\t{profile}\t{reason}".format(
            id=item.get("id", ""), status=item.get("status", ""), project=item.get("project", ""),
            profile=item.get("profile", ""), reason=reason))
    sys.exit(0)

item = pick(items)
if item is None:
    print("no build matching {0}".format(query or "latest"), file=sys.stderr)
    sys.exit(1)
if mode == "show":
    json.dump(public(item), sys.stdout, indent=2)
    sys.stdout.write("\n")
    sys.exit(0)
path = os.path.join(item["_dir"], "build.log")
if not os.path.isfile(path):
    print("no log for {0}".format(item.get("id")), file=sys.stderr)
    sys.exit(1)
sys.stdout.write(open(path, "r", errors="replace").read())
PY
}
commit_cmd() {
  local name="${1:?usage: macbuild commit <name> [--push]}" dir push=0
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --push) push=1;;
      *) echo "unknown option $1"; return 2;;
    esac
    shift
  done
  valid_name "$name" || { echo "bad name: $name"; return 1; }
  dir=$(N="$name" awk -F'|' '$1==ENVIRON["N"]{print $2}' "$PROJECTS" 2>/dev/null)
  [ -n "$dir" ] || { echo "unknown project: $name"; return 1; }
  node "$ROOT/lib/commit.mjs" start "$dir" --name "$name" ${push:+--push} --wait
}
warn_dirty() {
  # A --ref build uses origin. Local files never go in; offer T3 so related files stay in separate commits.
  local repo porcelain n
  [ -n "$REF" ] || return 0
  repo=$(git -C "$APP_DIR" rev-parse --show-toplevel 2>/dev/null) || return 0
  porcelain=$(git -C "$repo" status --porcelain 2>/dev/null) || return 0
  [ -n "$porcelain" ] || return 0
  echo "macbuild: local files not on GitHub (this --ref build skips them):"
  echo "$porcelain" | head -n 12
  n=$(printf '%s\n' "$porcelain" | grep -c .)
  [ "$n" -gt 12 ] && echo "  … $((n - 12)) more"
  echo "  split, commit and push: macbuild commit $NAME --push"
}
case "${1:-}" in
  list) cat "$PROJECTS" 2>/dev/null; exit 0;;
  add) add_project "${2:?usage: macbuild add <name> <path>}" "${3:?usage: macbuild add <name> <path>}"; exit $?;;
  scan) scan_projects; exit 0;;
  doctor) doctor "${2:-}"; exit $?;;
  setup) shift; setup_cmd "$@"; exit $?;;
  builds) history builds "${2:-}" "${3:-}"; exit $?;;
  log) history log "${2:-}" "${3:-}"; exit $?;;
  show) history show "${2:-}" "${3:-}"; exit $?;;
  commit) shift; commit_cmd "$@"; exit $?;;
esac
NAME=""; PROFILE=""; PLATFORM="ios"; FAST=0; SEND=0; INSTALL=0; SUBMIT=0; TESTFLIGHT=0; SKIP_UNCHANGED=0; OUT=""; REF=""; SCREENSHOT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) PROFILE="${2:?--profile needs a name}"; shift;;
    --platform) PLATFORM="${2:?--platform needs ios or android}"; shift;;
    --android) PLATFORM=android;;
    --output) OUT="${2:?--output needs a path}"; shift;;
    --ref) REF="${2:?--ref needs a branch or commit}"; shift;;
    --screenshot) SCREENSHOT="${2:?--screenshot needs a path}"; shift;;
    --fast) FAST=1;; --send) SEND=1;; --install) INSTALL=1;; --submit) SUBMIT=1;; --testflight) TESTFLIGHT=1; SUBMIT=1;;
    --skip-unchanged) SKIP_UNCHANGED=1;;
    --list) cat "$PROJECTS" 2>/dev/null; exit 0;;
    -h|--help) sed -n '2,15p' "$0"; exit 0;;
    -*) echo "unknown option $1"; exit 2;;
    *) NAME="$1";;
  esac; shift
done
[ -n "$NAME" ] || { echo "usage: macbuild <project> [--platform ios|android] [--install|--submit|--fast|--send|--profile NAME]"; exit 2; }
case "$PLATFORM" in ios|android) ;; *) echo "--platform is ios or android"; exit 2;; esac
[ "$TESTFLIGHT" = 0 ] || [ "$PLATFORM" = ios ] || { echo "--testflight is for iOS; use --submit to upload to Google Play"; exit 2; }
[ "$SUBMIT" = 0 ] || [ "$SKIP_UNCHANGED" = 0 ] || { echo "--skip-unchanged can't go with --submit: the store needs a new build"; exit 2; }
[ -z "$SCREENSHOT" ] || [ "$INSTALL" = 1 ] || { echo "--screenshot needs --install"; exit 2; }
if [ "$SUBMIT" = 1 ]; then PROFILE="${PROFILE:-production}"; fi
PROFILE="${PROFILE:-development}"
APP_DIR=$(N="$NAME" awk -F'|' '$1==ENVIRON["N"]{print $2}' "$PROJECTS" 2>/dev/null); APP_DIR="${APP_DIR:-$HOME/Documents/$NAME}"
[ -f "$APP_DIR/eas.json" ] || { echo "no eas.json in $APP_DIR"; exit 1; }
DEVICE="${MACBUILD_DEVICE:-}"; TAILDROP="${MACBUILD_TAILDROP_TARGET:-}"
[ "$SEND" = 0 ] || [ -n "$TAILDROP" ] || { echo "--send needs MACBUILD_TAILDROP_TARGET in $CONFIG/env"; exit 2; }
CACHE="$HOME/.cache/macbuild"; mkdir -p "$CACHE"
LOG="${MACBUILD_LOG:-$HOME/Library/Logs/$NAME-$PLATFORM-build-$PROFILE.log}"
LOCK="$CACHE/build.lock"; BUILT=""; WORK=""; WORKTREE=""; WORKTREE_REPO=""; EAS_PID=""; WATCHER=""; FIFO=""; SNAP=""; SIM_DIR=""
stop_eas() {
  # eas_pty.py passes the signal on to eas, then exits once eas has.
  local n=0
  [ -n "$WATCHER" ] && kill "$WATCHER" 2>/dev/null
  [ -n "$EAS_PID" ] || return 0
  kill "$EAS_PID" 2>/dev/null
  while kill -0 "$EAS_PID" 2>/dev/null && [ $n -lt 20 ]; do sleep 0.5; n=$((n + 1)); done
}
cleanup() {
  stop_eas
  [ -n "$WORKTREE" ] && git -C "$WORKTREE_REPO" worktree remove --force "$WORKTREE" 2>/dev/null
  [ -n "$WORK" ] && rm -rf "$WORK"
  [ -n "$SIM_DIR" ] && rm -rf "$SIM_DIR"
  [ -n "$FIFO" ] && rm -f "$FIFO" "$SNAP"
  [ -n "$BUILT" ] && rm -f "$BUILT"
  [ "$(readlink "$LOCK" 2>/dev/null)" = "$$" ] && rm -f "$LOCK"
}
trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
# One build at a time on this Mac, whether it was started here, by an agent or from the web UI: builds share the Metro
# cache, keychains and work directories, and each one uses the whole machine. The lock is a symlink to the owner's pid.
take_lock() {
  local owner said=0
  until ln -sn "$$" "$LOCK" 2>/dev/null; do
    owner=$(readlink "$LOCK" 2>/dev/null)
    if [ -n "$owner" ] && ps -p "$owner" -o command= 2>/dev/null | grep -q macbuild; then
      if [ "$said" = 0 ]; then
        said=1; echo "waiting for the build already running on this Mac (pid $owner)"
        [ -n "$OWN_LOG" ] && echo "waiting for the build already running on this Mac (pid $owner)" >> "$LOG"
      fi
      sleep 5
    elif [ "$(readlink "$LOCK" 2>/dev/null)" = "$owner" ]; then
      rm -f "$LOCK" # left by a build that is gone
    fi
  done
}
# The default log is shared by every build of this app and profile, so it is cleared only once this build holds the
# lock: clearing it earlier would erase the running build's prompts. A log the web UI passes is this build's alone.
OWN_LOG=${MACBUILD_LOG:+1}
[ -n "$OWN_LOG" ] && : > "$LOG"
take_lock
[ -n "$OWN_LOG" ] || : > "$LOG"
# Metro's temp cache embeds the absolute work directory, which changes per build: the next build then fails to resolve modules.
rm -rf "${TMPDIR:-/tmp}/metro-cache" "${TMPDIR:-/tmp}"/metro-file-map-* "${TMPDIR:-/tmp}"/haste-map-* 2>/dev/null
# A temporary EAS keychain left by a dead build stays in the search list, locked, and codesign can pick it (errSecInternalComponent).
if [ "$PLATFORM" = ios ] && ! pgrep -f eas_pty.py >/dev/null; then
  for k in $(security list-keychains -d user 2>/dev/null | tr -d '"' | grep '/eas-build-.*\.keychain'); do security delete-keychain "$k" 2>/dev/null; done
  rm -f "${TMPDIR:-/tmp}"/eas-build-*.keychain
fi
# MACBUILD_NODE picks the node that builds; every nvm version stays on the path so the global eas is found. Homebrew is
# added for CocoaPods and fastlane, which the web UI's login service would not otherwise find on Apple silicon.
for d in "$HOME"/.nvm/versions/node/*/bin /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin; do [ -d "$d" ] && PATH="$PATH:$d"; done
[ -n "${MACBUILD_NODE:-}" ] && PATH="$HOME/.nvm/versions/node/$MACBUILD_NODE/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"; unset DEVELOPER_DIR
# The web UI ignores this process's stdout, so every later echo has to land in the build log.
[ -n "$OWN_LOG" ] && exec >> "$LOG" 2>&1
[ "$PLATFORM" = android ] && android_env
# macbuild owns the EAS work directory: --fast keeps one per app and profile (cleared when the next one starts) and
# every other build gets a fresh one, removed when it ends.
if [ "$FAST" = 1 ]; then
  export EAS_LOCAL_BUILD_WORKINGDIR="$CACHE/work-$NAME-$PLATFORM-$PROFILE"; rm -rf "$EAS_LOCAL_BUILD_WORKINGDIR"; mkdir -p "$EAS_LOCAL_BUILD_WORKINGDIR"
  export XCODE_XCCONFIG_FILE="$ROOT/lib/fast.xcconfig"
else
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/macbuild-work.XXXXXX") || exit 1
  export EAS_LOCAL_BUILD_WORKINGDIR="$WORK"
fi
export EAS_LOCAL_BUILD_SKIP_CLEANUP=1
# Prompts: "pattern|reply". SEEN[i] = log size when last answered, so a prompt that returns for the keyboard extension is
# answered again. Indexed arrays only: macOS bash is 3.2.
SPECS=(
  '? Do you want to log in to your Apple account|y\n'
  '? Reuse this distribution certificate|y\n'
  '? Reuse this provisioning profile|y\n'
  '? Generate a new Apple Provisioning Profile|y\n'
  '? All your registered devices are present in the Provisioning Profile|\n'
  '? Select devices for the ad hoc build|\n'
  '? Select a Provider|\u001b[B\n'
  '? Would you like to set up Push Notifications|\u001b[B\n'
  '? Reuse this App Store Connect API Key|y\n'
  '? Apple ID:|\n'
  '? Generate a new Android Keystore|y\n'
)
run_eas() {
  local status
  FIFO=$(mktemp -u "${TMPDIR:-/tmp}/macbuild-in.XXXXXX"); mkfifo "$FIFO" || return 1
  SNAP=$(mktemp "${TMPDIR:-/tmp}/macbuild-log.XXXXXX") || return 1
  ( exec 3<>"$FIFO"; exec nice -n 15 /usr/bin/python3 "$ROOT/lib/eas_pty.py" "$@" <&3 >>"$LOG" 2>&1 ) &
  EAS_PID=$!
  # The log is cleaned once each time it grows, not once per prompt.
  ( for i in "${!SPECS[@]}"; do SEEN[i]=0; done; last=""
    while kill -0 "$EAS_PID" 2>/dev/null; do
      size=$(wc -c < "$LOG")
      if [ "$size" != "$last" ]; then
        last=$size; clean > "$SNAP"; total=$(wc -c < "$SNAP")
        for i in "${!SPECS[@]}"; do
          spec="${SPECS[$i]}"; pattern="${spec%%|*}"; reply="${spec#*|}"
          if tail -c +$(( SEEN[i] + 1 )) "$SNAP" | tail -c 8000 | grep -q -F "$pattern"; then
            SEEN[i]=$total
            printf '{"text":"%s"}\n' "$reply" > "$FIFO"; sleep 2
          fi
        done
      fi
      sleep 2
    done ) &
  WATCHER=$!
  wait "$EAS_PID"; status=$?
  kill "$WATCHER" 2>/dev/null; wait "$WATCHER" 2>/dev/null
  rm -f "$FIFO" "$SNAP"; EAS_PID=""; WATCHER=""; FIFO=""; SNAP=""; return $status
}
# Which lockfile eas should install from. package.json "packageManager" wins, then a pnpm workspace,
# then the same order eas-cli uses (npm, yarn, pnpm, bun). Extra lockfiles are dropped in the worktree
# so eas doesn't silently switch to npm because a leftover package-lock.json is sitting there.
lockfile_of() {
  local dir="$1" pm
  pm=$(python3 -c '
import json, os, sys
try:
    raw = str(json.load(open(os.path.join(sys.argv[1], "package.json"))).get("packageManager") or "")
except Exception:
    raw = ""
print(raw.split("@")[0])
' "$dir" 2>/dev/null || true)
  case "$pm" in
    pnpm) [ -f "$dir/pnpm-lock.yaml" ] && { echo pnpm-lock.yaml; return; } ;;
    yarn) [ -f "$dir/yarn.lock" ] && { echo yarn.lock; return; } ;;
    bun)
      [ -f "$dir/bun.lock" ] && { echo bun.lock; return; }
      [ -f "$dir/bun.lockb" ] && { echo bun.lockb; return; }
      ;;
    npm) [ -f "$dir/package-lock.json" ] && { echo package-lock.json; return; } ;;
  esac
  if [ -f "$dir/pnpm-workspace.yaml" ] && [ -f "$dir/pnpm-lock.yaml" ]; then echo pnpm-lock.yaml; return; fi
  local f
  for f in package-lock.json yarn.lock pnpm-lock.yaml bun.lock bun.lockb; do
    [ -f "$dir/$f" ] && { echo "$f"; return; }
  done
}
checkout() {
  # A worktree at the pushed commit: uncommitted files in the project never reach the build. EAS reads the app config from
  # here, which needs node_modules; the build itself installs its own. .env files are ignored by git, so they are copied.
  local repo sub sha src app lock extra
  repo=$(git -C "$APP_DIR" rev-parse --show-toplevel) || return 1
  # The app's folder inside the repo, from git itself: APP_DIR may reach the repo through a symlink.
  sub=$(git -C "$APP_DIR" rev-parse --show-prefix); sub=${sub%/}
  git -C "$repo" fetch -q --prune origin || { echo "git fetch failed"; return 1; }
  sha=$(git -C "$repo" rev-parse --verify -q "origin/$REF^{commit}" || git -C "$repo" rev-parse --verify -q "$REF^{commit}") || { echo "unknown ref $REF"; return 1; }
  src="$CACHE/src/$NAME"; app="$src${sub:+/$sub}"; mkdir -p "$CACHE/src"
  git -C "$repo" worktree remove --force "$src" 2>/dev/null || rm -rf "$src"; git -C "$repo" worktree prune
  git -C "$repo" worktree add -q --detach "$src" "$sha" || return 1
  WORKTREE_REPO=$repo; WORKTREE=$src
  for f in .env .env.local; do [ -f "$APP_DIR/$f" ] && cp "$APP_DIR/$f" "$app/$f"; done
  lock=$(lockfile_of "$src")
  echo "source: $REF at ${sha:0:7}, dependencies from ${lock:-no lockfile}"
  if [ -n "$lock" ]; then
    for extra in package-lock.json yarn.lock pnpm-lock.yaml bun.lock bun.lockb; do
      [ "$extra" = "$lock" ] && continue
      [ -f "$src/$extra" ] || continue
      echo "dropping $extra so eas uses ${lock}"
      rm -f "$src/$extra"
    done
  fi
  # Reuse the project's node_modules only when it matches this commit: another commit can need different packages.
  if [ -n "${lock:-}" ] && [ -d "$repo/node_modules" ] && cmp -s "$repo/$lock" "$src/$lock"; then
    ln -sfn "$repo/node_modules" "$src/node_modules"
    if [ -n "$sub" ] && [ -d "$APP_DIR/node_modules" ]; then ln -sfn "$APP_DIR/node_modules" "$app/node_modules"; fi
  else
    case "${lock:-}" in
      package-lock.json) (cd "$src" && npm ci --ignore-scripts --no-audit --no-fund) ;;
      bun.lock|bun.lockb) (cd "$src" && bun install --frozen-lockfile --ignore-scripts) ;;
      pnpm-lock.yaml) (cd "$src" && pnpm install --frozen-lockfile --ignore-scripts) ;;
      yarn.lock) (cd "$src" && yarn install --frozen-lockfile --ignore-scripts) ;;
      *) (cd "$src" && npm install --ignore-scripts --no-audit --no-fund) ;;
    esac || { echo "dependency install failed"; return 1; }
  fi
  APP_DIR="$app"
}
# Drops terminal escape codes. The escape byte is written out ($'\033') because not every sed reads \x1b.
clean() { sed $'s/\033\\[[0-9;?]*[A-Za-z]//g' "$LOG"; }
# After a failure: the known cause and its fix, when lib/diagnose.mjs recognises the error.
explain() { node "$ROOT/lib/diagnose.mjs" "$LOG" 2>/dev/null | sed 's/^/  /'; }
install_simulator() {
  # Opens the app in MACBUILD_SIMULATOR, the booted simulator, or the first available iPhone, booting it if needed.
  local app bundle device
  SIM_DIR=$(mktemp -d "${TMPDIR:-/tmp}/macbuild-sim.XXXXXX") || return 1
  tar -xzf "$ARTIFACT" -C "$SIM_DIR" || { echo "could not unpack the simulator build"; return 1; }
  app=$(find "$SIM_DIR" -maxdepth 3 -name '*.app' -type d | head -n 1)
  [ -n "$app" ] || { echo "no .app in the simulator build"; return 1; }
  bundle=$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$app/Info.plist") || return 1
  device=${MACBUILD_SIMULATOR:-booted}
  if [ "$device" = booted ] && ! xcrun simctl list devices booted | grep -q Booted; then
    device=$(xcrun simctl list devices available | grep -m1 -oE 'iPhone[^(]*\([0-9A-F-]{36}\)' | grep -oE '[0-9A-F-]{36}')
    [ -n "$device" ] || { echo "no iPhone simulator found; add one in Xcode"; return 1; }
    xcrun simctl boot "$device" && open -a Simulator
  fi
  xcrun simctl install "$device" "$app" && xcrun simctl launch "$device" "$bundle" >/dev/null || return 1
  echo "opened $bundle in the simulator"
  if [ -n "$SCREENSHOT" ]; then sleep 8; xcrun simctl io "$device" screenshot "$SCREENSHOT" >/dev/null && echo "screenshot: $SCREENSHOT"; fi
}
if [ -n "$REF" ]; then
  warn_dirty
  checkout >> "$LOG" 2>&1 || { echo "checkout failed; log: $LOG"; tail -n 5 "$LOG"; exit 1; }
fi
cd "$APP_DIR" || exit 1
# The profile decides the artifact: an IPA, a simulator .tar.gz, an APK or an AAB.
EXT=""; SIMULATOR=0; MISSING=0
while IFS='=' read -r key value; do
  case "$key" in artifact) EXT=$value;; simulator) SIMULATOR=$value;; missing) MISSING=$value;; esac
done < <(node "$ROOT/lib/profile.mjs" "$APP_DIR/eas.json" "$PROFILE" "$PLATFORM" 2>/dev/null)
[ "$MISSING" = 0 ] || { echo "no build profile \"$PROFILE\" in $APP_DIR/eas.json"; exit 1; }
if [ -z "$EXT" ]; then EXT=ipa; [ "$PLATFORM" = android ] && EXT=apk; fi
# eas.json profile env (merged with extends). eas-cli's local fingerprint and the
# in-build one both evaluate app.config.js, so APP_VARIANT and friends must be set here.
export EAS_BUILD_PROFILE="$PROFILE"
eval "$(node "$ROOT/lib/profile.mjs" --export-env "$APP_DIR/eas.json" "$PROFILE" 2>/dev/null | python3 -c '
import json, sys, shlex
raw = sys.stdin.read().strip()
env = json.loads(raw) if raw else {}
if not isinstance(env, dict):
    raise SystemExit(0)
for key, value in env.items():
    if not isinstance(key, str) or not key.isidentifier():
        continue
    print("export %s=%s" % (key, shlex.quote("" if value is None else str(value))))
')"
# Settings used after the build are checked first, so a missing one doesn't waste the build.
if [ "$INSTALL" = 1 ]; then
  if [ "$PLATFORM" = android ]; then
    [ "$EXT" = apk ] || { echo "--install needs an APK; this profile builds an AAB for Google Play (set android.buildType to apk)"; exit 2; }
  elif [ "$SIMULATOR" = 0 ]; then
    [ -n "$DEVICE" ] || { echo "--install needs MACBUILD_DEVICE in $CONFIG/env (see: xcrun devicectl list devices)"; exit 2; }
  fi
fi
[ -z "$SCREENSHOT" ] || [ "$SIMULATOR" = 1 ] || { echo "--screenshot works with simulator builds"; exit 2; }
[ "$SUBMIT" = 0 ] || [ "$SIMULATOR" = 0 ] || { echo "simulator builds can't be uploaded to the App Store"; exit 2; }
# The native code's fingerprint: logged for the web UI, recorded after the build, and compared by --skip-unchanged.
FP=$(node "$ROOT/lib/fingerprint.mjs" "$APP_DIR" "$PLATFORM" 2>/dev/null | tail -n 1)
[ -n "$FP" ] && echo "macbuild: fingerprint $FP" >> "$LOG"
SKIPPED=0; ARTIFACT=""
if [ "$SKIP_UNCHANGED" = 1 ] && [ -n "$FP" ]; then
  # The newest build with this fingerprint whose file is still there and still holds that build: a later build can
  # overwrite the same path (the Desktop default), so a path counts only if its most recent record has this fingerprint.
  ARTIFACT=$(N="$NAME" P="$PROFILE" PL="$PLATFORM" F="$FP" awk -F'|' '{ last[$5] = $4 }
    $1 == ENVIRON["N"] && $2 == ENVIRON["P"] && $3 == ENVIRON["PL"] && $4 == ENVIRON["F"] { hits[++n] = $5 }
    END { for (i = n; i > 0; i--) if (last[hits[i]] == ENVIRON["F"]) { print hits[i]; exit } }' "$FINGERPRINTS" 2>/dev/null)
  if [ -n "$ARTIFACT" ] && [ -f "$ARTIFACT" ]; then
    SKIPPED=1
    echo "macbuild: unchanged since $ARTIFACT" >> "$LOG"
    echo "native code unchanged since an earlier build; reusing $ARTIFACT"
  else
    ARTIFACT=""
  fi
fi
if [ "$SKIPPED" = 0 ]; then
  # This run's build: a path of its own, so a failed build can't pick up another build's output.
  BUILT="$CACHE/$NAME-$PROFILE.$$.$EXT"
  echo "building $NAME for $PLATFORM ($PROFILE) on this Mac, log: $LOG"
  # --non-interactive skips credential reuse menus when EAS already has certs/profiles.
  # Only with --ref: eas aborts a dirty working copy under --non-interactive.
  run_eas build --platform "$PLATFORM" --profile "$PROFILE" --local ${REF:+--non-interactive} --output "$BUILT"; STATUS=$?
  if [ ! -f "$BUILT" ]; then
    echo "build failed (exit $STATUS); log: $LOG"; clean | grep -E "❌|error:|Error:|FAILURE" | head -8; explain; exit 1
  fi
  ARTIFACT="${OUT:-$HOME/Desktop/$NAME-$PROFILE.$EXT}"
  mv "$BUILT" "$ARTIFACT" || { echo "could not move the build to $ARTIFACT" >&2; exit 1; }
  BUILT=""
  echo "built: $ARTIFACT ($(du -h "$ARTIFACT" | cut -f1)) in $(( (SECONDS-START)/60 )) min"
  if [ -n "$FP" ]; then
    mkdir -p "$(dirname "$FINGERPRINTS")"
    printf '%s|%s|%s|%s|%s|%s\n' "$NAME" "$PROFILE" "$PLATFORM" "$FP" "$ARTIFACT" "$(date +%s)" >> "$FINGERPRINTS"
  fi
fi
if [ "$SEND" = 1 ]; then
  /Applications/Tailscale.app/Contents/MacOS/Tailscale file cp --name="$(basename "$ARTIFACT")" "$ARTIFACT" "$TAILDROP:" || { echo "could not send to $TAILDROP" >&2; exit 1; }
  echo "sent to $TAILDROP"
fi
if [ "$INSTALL" = 1 ]; then
  if [ "$PLATFORM" = android ]; then
    ADB=(adb); [ -n "${MACBUILD_ANDROID_DEVICE:-}" ] && ADB+=(-s "$MACBUILD_ANDROID_DEVICE")
    "${ADB[@]}" install -r "$ARTIFACT" || { echo "install failed: is a device connected with USB debugging on? (adb devices)" >&2; exit 1; }
  elif [ "$SIMULATOR" = 1 ]; then
    install_simulator || { echo "could not open the app in the simulator" >&2; exit 1; }
  else
    INSTALL_DIR=$(mktemp -d "${TMPDIR:-/tmp}/macbuild-install.XXXXXX") || exit 1
    if ! unzip -q "$ARTIFACT" 'Payload/*' -d "$INSTALL_DIR"; then
      rm -rf "$INSTALL_DIR"; echo "could not extract app from IPA" >&2; exit 1
    fi
    APP_BUNDLES=("$INSTALL_DIR"/Payload/*.app)
    if [ "${#APP_BUNDLES[@]}" -ne 1 ] || [ ! -d "${APP_BUNDLES[0]}" ]; then
      rm -rf "$INSTALL_DIR"; echo "IPA must contain one app bundle" >&2; exit 1
    fi
    xcrun devicectl device install app --device "$DEVICE" "${APP_BUNDLES[0]}" 2>&1 | tail -6
    STATUS=${PIPESTATUS[0]}
    rm -rf "$INSTALL_DIR"
    [ "$STATUS" = 0 ] || { echo "install failed (exit $STATUS)" >&2; exit "$STATUS"; }
  fi
fi
if [ "$SUBMIT" = 1 ]; then
  STORE="TestFlight"; [ "$PLATFORM" = android ] && STORE="Google Play"
  # The submit profile named like the build profile, else production (which eas.json may leave out).
  SUBMIT_PROFILE=$(node -e 'const s = (JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).submit || {}); console.log(s[process.argv[2]] ? process.argv[2] : "production")' "$APP_DIR/eas.json" "$PROFILE" 2>/dev/null) || SUBMIT_PROFILE=production
  echo "uploading to $STORE (submit profile ${SUBMIT_PROFILE:-production})"
  run_eas submit --platform "$PLATFORM" --profile "${SUBMIT_PROFILE:-production}" --path "$ARTIFACT" --wait; STATUS=$?
  clean | tail -n 400 | grep -a -E 'Submitted your app|Submission details|failed|Error' | tail -4
  [ $STATUS = 0 ] || { echo "upload failed (exit $STATUS); log: $LOG"; explain; exit 1; }
fi
exit 0
