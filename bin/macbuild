#!/bin/bash
# Builds an iOS app on this Mac (eas build --local), answering the EAS prompts.
#   macbuild <project> [--profile NAME] [--fast] [--install] [--send] [--testflight] [--output PATH]
#   --profile     eas.json build profile (default development)
#   --fast        fixed work directory + Xcode compilation caching, so later builds reuse compiled output
#   --install     install on the paired iPhone with devicectl
#   --send        Taildrop the IPA to the iPhone
#   --testflight  production build, then upload to TestFlight (eas submit --path)
#   --ref REF     build a pushed branch, tag or commit in a clean checkout (default: the working copy)
# Other commands: macbuild list | add <name> <path> | scan | doctor
# Projects: ~/.config/macbuild/projects.conf (name|path). Settings: ~/.config/macbuild/env.
set -u
START=$SECONDS
HERE=$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd); [ -d "$HERE/../lib" ] || HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
CONFIG="$HOME/.config/macbuild"; PROJECTS="${MACBUILD_PROJECTS:-$CONFIG/projects.conf}"
[ -f "$CONFIG/env" ] && . "$CONFIG/env"
export MACBUILD_APPLE_ID MACBUILD_APPLE_PASSWORD_FILE
# Project names end up in URLs, file names and build ids.
valid_name() { case "$1" in ""|[!A-Za-z0-9]*|*[!A-Za-z0-9._-]*) return 1;; esac; }
has_name() { N="$1" awk -F'|' '$1==ENVIRON["N"]{f=1} END{exit !f}' "$PROJECTS" 2>/dev/null; }
has_dir() { D="$1" awk -F'|' '$2==ENVIRON["D"]{f=1} END{exit !f}' "$PROJECTS" 2>/dev/null; }
slug() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-*//; s/-*$//'; }
add_project() {
  local name="$1" dir
  valid_name "$name" || { echo "bad name: $name (letters, digits, '.', '_' and '-', starting with a letter or digit)"; return 1; }
  dir=$(cd "$2" 2>/dev/null && pwd) || { echo "no such folder: $2"; return 1; }
  [ -f "$dir/eas.json" ] || { echo "no eas.json in $dir"; return 1; }
  mkdir -p "$CONFIG"; touch "$PROJECTS"
  N="$name" awk -F'|' '$1!=ENVIRON["N"]' "$PROJECTS" > "$PROJECTS.tmp"
  echo "$name|$dir" >> "$PROJECTS.tmp"; mv "$PROJECTS.tmp" "$PROJECTS"; echo "added $name: $dir"
}
scan_projects() {
  # Expo apps under the usual project folders; an app already listed keeps its name. When two apps share a folder name
  # (apps/mobile in two monorepos), the second is named after its repository too, so neither replaces the other.
  local root file dir name repo n
  for root in "$HOME/Documents" "$HOME/Developer" "$HOME/Projects" "$HOME/code" "$HOME/src"; do
    [ -d "$root" ] || continue
    find "$root" -maxdepth 4 -name eas.json -not -path '*/node_modules/*' -not -path '*/.git/*' 2>/dev/null | while read -r file; do
      dir=$(dirname "$file")
      has_dir "$dir" && continue
      name=$(slug "$(basename "$dir")"); name=${name:-app}
      if has_name "$name"; then
        repo=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) && repo=$(slug "$(basename "$repo")")
        if [ -n "$repo" ] && [ "$repo" != "$name" ] && ! has_name "$repo-$name"; then name="$repo-$name"
        else n=2; while has_name "$name-$n"; do n=$((n + 1)); done; name="$name-$n"; fi
      fi
      add_project "$name" "$dir"
    done
  done
}
doctor() {
  local bad=0 names
  ok() { printf '  ok    %-12s %s\n' "$1" "$2"; }
  no() { printf '  MISS  %-12s %s\n' "$1" "$2"; bad=1; }
  opt() { printf '  skip  %-12s %s\n' "$1" "$2"; }
  [ "$(uname)" = Darwin ] && ok macOS "$(sw_vers -productVersion)" || no macOS "iOS builds need a Mac"
  xcodebuild -version >/dev/null 2>&1 && ok Xcode "$(xcodebuild -version | head -1)" || no Xcode "install from the App Store, then run: sudo xcode-select -s /Applications/Xcode.app"
  command -v node >/dev/null && ok node "$(node -v)" || no node "install Node.js 20 or newer"
  command -v git >/dev/null && ok git "$(git --version | cut -d' ' -f3)" || no git "xcode-select --install"
  command -v pod >/dev/null && ok CocoaPods "$(pod --version 2>/dev/null)" || no CocoaPods "brew install cocoapods"
  command -v fastlane >/dev/null && ok fastlane "installed" || no fastlane "brew install fastlane"
  if command -v eas >/dev/null; then
    ok eas-cli "$(eas --version 2>/dev/null | grep -o 'eas-cli/[0-9.]*' | head -1)"
    who=$(eas whoami 2>/dev/null | grep -vE 'eas-cli@|upgrade|npm install|outdated' | grep -m1 .); case "$who" in ""|*"Not logged in"*) no "Expo login" "run: eas login";; *) ok "Expo login" "$who";; esac
  else no eas-cli "npm install -g eas-cli"; fi
  command -v gh >/dev/null && gh auth status >/dev/null 2>&1 && ok "GitHub CLI" "signed in" || opt "GitHub CLI" "optional: PR and CI details in the web UI"
  [ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] || command -v tailscale >/dev/null && ok Tailscale "installed" || opt Tailscale "optional: needed to use the web UI from a phone"
  [ -s "$PROJECTS" ] && ok projects "$(grep -c '|' "$PROJECTS") listed" || no projects "run: macbuild scan, or macbuild add <name> <path>"
  names=$(grep -v '^#' "$PROJECTS" 2>/dev/null | grep '|' | cut -d'|' -f1 | while read -r name; do valid_name "$name" || printf '"%s" ' "$name"; done)
  [ -z "$names" ] || no names "rename ${names}in $PROJECTS: letters, digits, '.', '_' and '-' only"
  return $bad
}
case "${1:-}" in
  list) cat "$PROJECTS" 2>/dev/null; exit 0;;
  add) add_project "${2:?usage: macbuild add <name> <path>}" "${3:?usage: macbuild add <name> <path>}"; exit $?;;
  scan) scan_projects; exit 0;;
  doctor) doctor; exit $?;;
esac
NAME=""; PROFILE=""; FAST=0; SEND=0; INSTALL=0; TESTFLIGHT=0; OUT=""; REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --profile) PROFILE="${2:?--profile needs a name}"; shift;;
    --output) OUT="${2:?--output needs a path}"; shift;;
    --ref) REF="${2:?--ref needs a branch or commit}"; shift;;
    --fast) FAST=1;; --send) SEND=1;; --install) INSTALL=1;; --testflight) TESTFLIGHT=1;;
    --list) cat "$PROJECTS" 2>/dev/null; exit 0;;
    -h|--help) sed -n '2,11p' "$0"; exit 0;;
    -*) echo "unknown option $1"; exit 2;;
    *) NAME="$1";;
  esac; shift
done
[ -n "$NAME" ] || { echo "usage: macbuild <project> [--install|--testflight|--fast|--send|--profile NAME]"; exit 2; }
if [ "$TESTFLIGHT" = 1 ]; then PROFILE="${PROFILE:-production}"; fi
PROFILE="${PROFILE:-development}"
APP_DIR=$(N="$NAME" awk -F'|' '$1==ENVIRON["N"]{print $2}' "$PROJECTS" 2>/dev/null); APP_DIR="${APP_DIR:-$HOME/Documents/$NAME}"
[ -f "$APP_DIR/eas.json" ] || { echo "no eas.json in $APP_DIR"; exit 1; }
DEVICE="${MACBUILD_DEVICE:-}"; TAILDROP="${MACBUILD_TAILDROP_TARGET:-}"
# Settings used after the build are checked first, so a missing one doesn't waste the build.
[ "$INSTALL" = 0 ] || [ -n "$DEVICE" ] || { echo "--install needs MACBUILD_DEVICE in $CONFIG/env (see: xcrun devicectl list devices)"; exit 2; }
[ "$SEND" = 0 ] || [ -n "$TAILDROP" ] || { echo "--send needs MACBUILD_TAILDROP_TARGET in $CONFIG/env"; exit 2; }
CACHE="$HOME/.cache/macbuild"; mkdir -p "$CACHE"
LOG="${MACBUILD_LOG:-$HOME/Library/Logs/$NAME-ios-build-$PROFILE.log}"
# This run's IPA: a path of its own, so a failed build can't pick up another build's output.
BUILT="$CACHE/$NAME-$PROFILE.$$.ipa"
LOCK="$CACHE/build.lock"; WORK=""; WORKTREE=""; WORKTREE_REPO=""; EAS_PID=""; WATCHER=""; FIFO=""; SNAP=""
stop_eas() {
  # eas_pty.py passes the signal on to eas, then exits once eas has.
  local n=0
  [ -n "$WATCHER" ] && kill "$WATCHER" 2>/dev/null
  [ -n "$EAS_PID" ] || return 0
  kill "$EAS_PID" 2>/dev/null
  while kill -0 "$EAS_PID" 2>/dev/null && [ $n -lt 20 ]; do sleep 0.5; n=$((n + 1)); done
}
cleanup() {
  stop_eas
  [ -n "$WORKTREE" ] && git -C "$WORKTREE_REPO" worktree remove --force "$WORKTREE" 2>/dev/null
  [ -n "$WORK" ] && rm -rf "$WORK"
  [ -n "$FIFO" ] && rm -f "$FIFO" "$SNAP"
  rm -f "$BUILT"
  [ "$(readlink "$LOCK" 2>/dev/null)" = "$$" ] && rm -f "$LOCK"
}
trap cleanup EXIT; trap 'exit 130' INT; trap 'exit 143' TERM; trap 'exit 129' HUP
# One build at a time on this Mac, whether it was started here, by an agent or from the web UI: builds share the Metro
# cache, keychains and work directories, and each one uses the whole machine. The lock is a symlink to the owner's pid.
take_lock() {
  local owner said=0
  until ln -sn "$$" "$LOCK" 2>/dev/null; do
    owner=$(readlink "$LOCK" 2>/dev/null)
    if [ -n "$owner" ] && ps -p "$owner" -o command= 2>/dev/null | grep -q macbuild; then
      if [ "$said" = 0 ]; then
        said=1; echo "waiting for the build already running on this Mac (pid $owner)"
        [ -n "$OWN_LOG" ] && echo "waiting for the build already running on this Mac (pid $owner)" >> "$LOG"
      fi
      sleep 5
    elif [ "$(readlink "$LOCK" 2>/dev/null)" = "$owner" ]; then
      rm -f "$LOCK" # left by a build that is gone
    fi
  done
}
# The default log is shared by every build of this app and profile, so it is cleared only once this build holds the
# lock: clearing it earlier would erase the running build's prompts. A log the web UI passes is this build's alone.
OWN_LOG=${MACBUILD_LOG:+1}
[ -n "$OWN_LOG" ] && : > "$LOG"
take_lock
[ -n "$OWN_LOG" ] || : > "$LOG"
# Metro's temp cache embeds the absolute work directory, which changes per build: the next build then fails to resolve modules.
rm -rf "${TMPDIR:-/tmp}/metro-cache" "${TMPDIR:-/tmp}"/metro-file-map-* "${TMPDIR:-/tmp}"/haste-map-* 2>/dev/null
# A temporary EAS keychain left by a dead build stays in the search list, locked, and codesign can pick it (errSecInternalComponent).
if ! pgrep -f eas_pty.py >/dev/null; then
  for k in $(security list-keychains -d user 2>/dev/null | tr -d '"' | grep '/eas-build-.*\.keychain'); do security delete-keychain "$k" 2>/dev/null; done
  rm -f "${TMPDIR:-/tmp}"/eas-build-*.keychain
fi
# MACBUILD_NODE picks the node that builds; every nvm version stays on the path so the global eas is found. Homebrew is
# added for CocoaPods and fastlane, which the web UI's login service would not otherwise find on Apple silicon.
for d in "$HOME"/.nvm/versions/node/*/bin /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin; do [ -d "$d" ] && PATH="$PATH:$d"; done
[ -n "${MACBUILD_NODE:-}" ] && PATH="$HOME/.nvm/versions/node/$MACBUILD_NODE/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"; unset DEVELOPER_DIR
# macbuild owns the EAS work directory: --fast keeps one per app and profile (cleared when the next one starts) and
# every other build gets a fresh one, removed when it ends.
if [ "$FAST" = 1 ]; then
  export EAS_LOCAL_BUILD_WORKINGDIR="$CACHE/work-$NAME-$PROFILE"; rm -rf "$EAS_LOCAL_BUILD_WORKINGDIR"; mkdir -p "$EAS_LOCAL_BUILD_WORKINGDIR"
  export XCODE_XCCONFIG_FILE="$ROOT/lib/fast.xcconfig"
else
  WORK=$(mktemp -d "${TMPDIR:-/tmp}/macbuild-work.XXXXXX") || exit 1
  export EAS_LOCAL_BUILD_WORKINGDIR="$WORK"
fi
export EAS_LOCAL_BUILD_SKIP_CLEANUP=1
# Prompts: "pattern|reply". SEEN[i] = log size when last answered, so a prompt that returns for the keyboard extension is
# answered again. Indexed arrays only: macOS bash is 3.2.
SPECS=(
  '? Do you want to log in to your Apple account|y\n'
  '? Reuse this distribution certificate|y\n'
  '? Reuse this provisioning profile|y\n'
  '? Generate a new Apple Provisioning Profile|y\n'
  '? All your registered devices are present in the Provisioning Profile|\n'
  '? Select devices for the ad hoc build|\n'
  '? Select a Provider|\u001b[B\n'
  '? Would you like to set up Push Notifications|\u001b[B\n'
  '? Reuse this App Store Connect API Key|y\n'
  '? Apple ID:|\n'
)
run_eas() {
  local status
  FIFO=$(mktemp -u "${TMPDIR:-/tmp}/macbuild-in.XXXXXX"); mkfifo "$FIFO" || return 1
  SNAP=$(mktemp "${TMPDIR:-/tmp}/macbuild-log.XXXXXX") || return 1
  ( exec 3<>"$FIFO"; exec nice -n 15 /usr/bin/python3 "$ROOT/lib/eas_pty.py" "$@" <&3 >>"$LOG" 2>&1 ) &
  EAS_PID=$!
  # The log is cleaned once each time it grows, not once per prompt.
  ( for i in "${!SPECS[@]}"; do SEEN[i]=0; done; last=""
    while kill -0 "$EAS_PID" 2>/dev/null; do
      size=$(wc -c < "$LOG")
      if [ "$size" != "$last" ]; then
        last=$size; clean > "$SNAP"; total=$(wc -c < "$SNAP")
        for i in "${!SPECS[@]}"; do
          spec="${SPECS[$i]}"; pattern="${spec%%|*}"; reply="${spec#*|}"
          if tail -c +$(( SEEN[i] + 1 )) "$SNAP" | tail -c 8000 | grep -q -F "$pattern"; then
            SEEN[i]=$total
            printf '{"text":"%s"}\n' "$reply" > "$FIFO"; sleep 2
          fi
        done
      fi
      sleep 2
    done ) &
  WATCHER=$!
  wait "$EAS_PID"; status=$?
  kill "$WATCHER" 2>/dev/null; wait "$WATCHER" 2>/dev/null
  rm -f "$FIFO" "$SNAP"; EAS_PID=""; WATCHER=""; FIFO=""; SNAP=""; return $status
}
checkout() {
  # A worktree at the pushed commit: uncommitted files in the project never reach the build. EAS reads the app config from
  # here, which needs node_modules; the build itself installs its own. .env files are ignored by git, so they are copied.
  local repo sub sha src app lock
  repo=$(git -C "$APP_DIR" rev-parse --show-toplevel) || return 1
  # The app's folder inside the repo, from git itself: APP_DIR may reach the repo through a symlink.
  sub=$(git -C "$APP_DIR" rev-parse --show-prefix); sub=${sub%/}
  git -C "$repo" fetch -q --prune origin || { echo "git fetch failed"; return 1; }
  sha=$(git -C "$repo" rev-parse --verify -q "origin/$REF^{commit}" || git -C "$repo" rev-parse --verify -q "$REF^{commit}") || { echo "unknown ref $REF"; return 1; }
  src="$CACHE/src/$NAME"; app="$src${sub:+/$sub}"; mkdir -p "$CACHE/src"
  git -C "$repo" worktree remove --force "$src" 2>/dev/null || rm -rf "$src"; git -C "$repo" worktree prune
  git -C "$repo" worktree add -q --detach "$src" "$sha" || return 1
  WORKTREE_REPO=$repo; WORKTREE=$src
  for f in .env .env.local; do [ -f "$APP_DIR/$f" ] && cp "$APP_DIR/$f" "$app/$f"; done
  for f in package-lock.json bun.lock bun.lockb pnpm-lock.yaml yarn.lock; do [ -f "$src/$f" ] && lock=$f && break; done
  echo "source: $REF at ${sha:0:7}, dependencies from ${lock:-no lockfile}"
  # Reuse the project's node_modules only when it matches this commit: another commit can need different packages.
  if [ -n "${lock:-}" ] && [ -d "$repo/node_modules" ] && cmp -s "$repo/$lock" "$src/$lock"; then
    ln -sfn "$repo/node_modules" "$src/node_modules"
    if [ -n "$sub" ] && [ -d "$APP_DIR/node_modules" ]; then ln -sfn "$APP_DIR/node_modules" "$app/node_modules"; fi
  else
    case "${lock:-}" in
      package-lock.json) (cd "$src" && npm ci --ignore-scripts --no-audit --no-fund) ;;
      bun.lock|bun.lockb) (cd "$src" && bun install --frozen-lockfile --ignore-scripts) ;;
      pnpm-lock.yaml) (cd "$src" && pnpm install --frozen-lockfile --ignore-scripts) ;;
      yarn.lock) (cd "$src" && yarn install --frozen-lockfile --ignore-scripts) ;;
      *) (cd "$src" && npm install --ignore-scripts --no-audit --no-fund) ;;
    esac || { echo "dependency install failed"; return 1; }
  fi
  APP_DIR="$app"
}
# Drops terminal escape codes. The escape byte is written out ($'\033') because not every sed reads \x1b.
clean() { sed $'s/\033\\[[0-9;?]*[A-Za-z]//g' "$LOG"; }
if [ -n "$REF" ]; then
  checkout >> "$LOG" 2>&1 || { echo "checkout failed; log: $LOG"; tail -n 5 "$LOG"; exit 1; }
fi
cd "$APP_DIR" || exit 1
echo "building $NAME ($PROFILE) on this Mac, log: $LOG"
run_eas build --platform ios --profile "$PROFILE" --local --output "$BUILT"; STATUS=$?
if [ ! -f "$BUILT" ]; then
  echo "build failed (exit $STATUS); log: $LOG"; clean | grep -E "❌|error:|Error:" | head -8; exit 1
fi
IPA="${OUT:-$HOME/Desktop/$NAME-$PROFILE.ipa}"
mv "$BUILT" "$IPA" || { echo "could not move IPA to $IPA" >&2; exit 1; }
echo "IPA: $IPA ($(du -h "$IPA" | cut -f1)) in $(( (SECONDS-START)/60 )) min"
if [ "$SEND" = 1 ]; then
  /Applications/Tailscale.app/Contents/MacOS/Tailscale file cp --name="$NAME-$PROFILE.ipa" "$IPA" "$TAILDROP:" || { echo "could not send to $TAILDROP" >&2; exit 1; }
  echo "sent to $TAILDROP"
fi
if [ "$INSTALL" = 1 ]; then
  INSTALL_DIR=$(mktemp -d "${TMPDIR:-/tmp}/macbuild-install.XXXXXX") || exit 1
  if ! unzip -q "$IPA" 'Payload/*' -d "$INSTALL_DIR"; then
    rm -rf "$INSTALL_DIR"; echo "could not extract app from IPA" >&2; exit 1
  fi
  APP_BUNDLES=("$INSTALL_DIR"/Payload/*.app)
  if [ "${#APP_BUNDLES[@]}" -ne 1 ] || [ ! -d "${APP_BUNDLES[0]}" ]; then
    rm -rf "$INSTALL_DIR"; echo "IPA must contain one app bundle" >&2; exit 1
  fi
  xcrun devicectl device install app --device "$DEVICE" "${APP_BUNDLES[0]}" 2>&1 | tail -6
  STATUS=${PIPESTATUS[0]}
  rm -rf "$INSTALL_DIR"
  [ "$STATUS" = 0 ] || { echo "install failed (exit $STATUS)" >&2; exit "$STATUS"; }
fi
if [ "$TESTFLIGHT" = 1 ]; then
  # The submit profile named like the build profile, else production (which eas.json may leave out).
  SUBMIT=$(/usr/bin/python3 -c 'import json, sys; print(sys.argv[2] if sys.argv[2] in (json.load(open(sys.argv[1])).get("submit") or {}) else "production")' "$APP_DIR/eas.json" "$PROFILE" 2>/dev/null) || SUBMIT=production
  echo "uploading to TestFlight (submit profile $SUBMIT)"
  run_eas submit --platform ios --profile "$SUBMIT" --path "$IPA" --wait; STATUS=$?
  clean | tail -n 400 | grep -a -E 'Submitted your app|Submission details|failed|Error' | tail -4
  [ $STATUS = 0 ] || { echo "upload failed (exit $STATUS); log: $LOG"; exit 1; }
fi
exit 0
