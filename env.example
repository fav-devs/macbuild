# ~/.config/macbuild/env. Stays on this Mac; never commit it.
# Apple account, so builds don't stop to ask. The password is read from a file; leave both empty to use EAS's saved session.
MACBUILD_APPLE_ID=
MACBUILD_APPLE_PASSWORD_FILE=
# Device identifier from: xcrun devicectl list devices (for --install)
MACBUILD_DEVICE=
# Tailscale device name (for --send)
MACBUILD_TAILDROP_TARGET=
# nvm Node version to build with, e.g. v22.17.0 (default: whatever is on your PATH)
MACBUILD_NODE=
# Simulator for --install with a simulator profile: a name or UDID from xcrun simctl list (default: the booted one)
MACBUILD_SIMULATOR=
# Android: the device serial from adb devices, when more than one is connected (for --install)
MACBUILD_ANDROID_DEVICE=
# Android SDK and Java 17, only if they aren't where Android Studio puts them (uncomment to use)
# ANDROID_HOME=/path/to/Android/sdk
# JAVA_HOME=/path/to/jdk-17
